/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/mt65xx.h>

/ {
	model = "SL-3000 eMMC";
	compatible = "sl,3000-emmc", "mediatek,mt7981";

	aliases {
		ethernet0 = &eth;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x40000000>; /* 锁定 1024M DRAM */
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

/* 物理修复：注入以太网节点，解决 eth0 报错 */
&eth {
	status = "okay";
	mediatek,gmac-id = <0>;
	phy-mode = "2500base-x"; /* SL3000 通常为 2.5G SGMII/2500Base-X */
	
	fixed-link {
		speed = <2500>;
		full-duplex;
		pause;
	};
};

&mdio {
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	hs400-ds-delay = <0x14014>;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	non-removable;
	status = "okay";
};

&pio {
	mmc0_pins_default: mmc0-pins-default {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
		conf {
			pins = "MSDC0_CLK";
			drive-strength = <MTK_DRIVE_10mA>;
		};
		conf-common {
			pins = "MSDC0_DAT0", "MSDC0_DAT1", "MSDC0_DAT2",
			       "MSDC0_DAT3", "MSDC0_DAT4", "MSDC0_DAT5",
			       "MSDC0_DAT6", "MSDC0_DAT7", "MSDC0_CMD", "MSDC0_DSL";
			input-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc0_pins_uhs: mmc0-pins-uhs {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
		conf {
			pins = "MSDC0_CLK";
			drive-strength = <MTK_DRIVE_10mA>;
		};
		conf-common {
			pins = "MSDC0_DAT0", "MSDC0_DAT1", "MSDC0_DAT2",
			       "MSDC0_DAT3", "MSDC0_DAT4", "MSDC0_DAT5",
			       "MSDC0_DAT6", "MSDC0_DAT7", "MSDC0_CMD", "MSDC0_DSL";
			input-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};
};

&uart0 {
	status = "okay";
};

&watchdog {
	status = "okay";
};

/* 补全 USB 支持，否则 SL3000 的 USB 接口将失效 */
&usb_phy {
	status = "okay";
};

&xhci0 {
	status = "okay";
};
